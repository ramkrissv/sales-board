      "scopes": ["personal"]
    },
    {
      "entityId": "ask",
      "name": "Ask Galent",
      "contentUrl": "https://salespilot.galent.ai/ask",
      "websiteUrl": "https://salespilot.galent.ai/ask",
      "scopes": ["personal"]
    },
    {
      "entityId": "intake",
      "name": "Signal Capture",
      "contentUrl": "https://salespilot.galent.ai/intake",
      "websiteUrl": "https://salespilot.galent.ai/intake",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
