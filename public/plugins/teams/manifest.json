      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": true,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            { "title": "help", "description": "What can SalesPilot do?" },
            { "title": "pipeline", "description": "Get pipeline summary" },
            { "title": "at-risk", "description": "Show deals at risk" }
          ]
        },
        {
          "scopes": ["team", "groupChat"],
          "commands": [
            { "title": "help", "description": "What can SalesPilot do?" },
            { "title": "capture", "description": "Capture this conversation as a deal signal" }
          ]
        }
      ]
