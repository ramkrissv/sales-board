#!/bin/sh
# Pre-commit hook: verify build passes before allowing commit

echo "Running pre-commit checks..."

# 1. Check for hardcoded secrets (not env var references)
if grep -rn "sk-ant-api0[0-9a-zA-Z]\{20,\}\|mongodb+srv://[^\"]*@" --include="*.ts" --include="*.tsx" --include="*.js" src/ 2>/dev/null; then
  echo "ERROR: Hardcoded secret found in source code. Aborting commit."
  exit 1
fi

# 2. Check for dangerouslySetInnerHTML
if grep -rn "dangerouslySetInnerHTML" --include="*.tsx" src/ 2>/dev/null; then
  echo "WARNING: dangerouslySetInnerHTML detected. Verify it's safe."
fi

# 3. TypeScript check (fast — uses tsbuildinfo cache)
npx tsc --noEmit 2>/dev/null
if [ $? -ne 0 ]; then
  echo "ERROR: TypeScript errors found. Fix before committing."
  exit 1
fi

echo "Pre-commit checks passed."
